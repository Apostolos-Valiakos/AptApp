{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.spec.config.mjs" },
  "mutate": [
    "client/src/composables/useBookingTotals.ts",
    "client/src/composables/useLogout.ts",
    "client/src/utils/discount.ts",
    "client/src/stores/auth.ts",
    "client/src/stores/calendar.ts",
    "client/src/router/index.ts:145-199",
    "client/src/views/LoginView.vue",
    "client/src/views/SchedulerView.vue:1058-1188",
    "client/src/views/SchedulerView.vue:1370-1453"
  ],
  "ignorePatterns": [
    "/ai",
    "/landing",
    "/android",
    "/scripts",
    "/assets",
    "/dist",
    "/client/dist",
    "/.claude",
    "/reports",
    "*.sql",
    "*.pdf",
    "*.dump"
  ],
  "reporters": ["clear-text", "html", "json", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "timeoutMS": 30000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "thresholds": { "high": 80, "low": 60, "break": null }
}
