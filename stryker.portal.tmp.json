{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.spec.config.mjs"
  },
  "mutate": [
    "client/src/portal/utils/upNext.ts",
    "client/src/portal/utils/calendarFile.ts",
    "client/src/portal/flag.ts",
    "client/src/portal/composables/usePortalBookingActions.ts",
    "client/src/portal/composables/useBookFlow.ts"
  ],
  "ignorePatterns": [
    "/ai",
    "/landing",
    "/android",
    "/scripts",
    "/assets",
    "/dist",
    "/client/dist",
    "/.claude",
    "/reports",
    "*.sql",
    "*.pdf",
    "*.dump"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation-portal/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-portal/mutation.json"
  },
  "timeoutMS": 30000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp-portal",
  "cleanTempDir": "always",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}